#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo -e "${YELLOW}🔍 [Pre-Commit] Starte Sicherheits- und Style-Checks...${NC}"

# --- 1. SECRET CHECK (wie vorher) ---
FORBIDDEN="(secrets|credential|private|key|\.env|_rsa|ghp_|gho_)"
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if echo "$STAGED_FILES" | grep -E -q "$FORBIDDEN"; then
    echo -e "${RED}❌ FEHLER: Verdächtige Dateinamen oder Inhalte gefunden!${NC}"
    exit 1
fi

# --- 2. CHECKSTYLE (Code Formatierung) ---
# Wir prüfen, ob Java-Dateien geändert wurden
if echo "$STAGED_FILES" | grep -q ".java$"; then
    echo -e "${YELLOW}🎨 Führe Checkstyle aus...${NC}"

    # Führt nur Checkstyle aus, nicht die Tests (spart Zeit!)

    ./gradlew checkstyleMain checkstyleTest

    EXIT_CODE=$?

    if [ $EXIT_CODE -ne 0 ]; then
        echo -e "${RED}❌ FEHLER: Checkstyle hat Verstöße gefunden!${NC}"
        echo -e "Bitte korrigiere die Formatierung (z.B. Einrückungen, Variablennamen) und versuche es erneut."
        exit 1
    fi
else
    echo "Keine Java-Dateien geändert. Überspringe Checkstyle."
fi

echo -e "${GREEN}✅ Pre-Commit Checks bestanden. Commit wird erstellt.${NC}"
exit 0